[Unit]
Description=SNH48 website FastAPI service (Aliyun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snh48-web
Group=snh48-web
WorkingDirectory=/home/snh48_web
EnvironmentFile=/home/snh48_web/.env
Environment=HOME=/var/lib/snh48-web
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/snh48_web/venv/bin/python -m website.main
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/home/snh48_web/website/data /home/snh48_web/transcript_analyze/logs_backup /home/snh48_web/transcript_analyze/video_knowledge_db /var/lib/snh48-web /home/snh48-fan-hub/room_record/陈嘉仪_161808449/score_gifts /home/snh48-fan-hub/live_push_replays/陈嘉仪_161808449/.danmu_url_cache

[Install]
WantedBy=multi-user.target
