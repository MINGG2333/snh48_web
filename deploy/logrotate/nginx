# Keep rotated Nginx logs until the website archive timer has uploaded and
# verified them in COS. The timer is the only cleanup path.
#
# Do NOT use an enormous rotate count here. logrotate enumerates every
# generation when rotating, so `rotate 1000000000` makes one run spin for
# hours at 100% CPU. 3650 daily generations (~10 years) still preserves the
# "don't delete by file count" intent while keeping each run fast.
/var/log/nginx/*.log {
    # The Nginx master opens logs as root; avoid distro-specific nginx users.
    create 0640 root root
    daily
    rotate 3650
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /bin/kill -USR1 `cat /run/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}
